{
  "name": "pest-ai-os-web",
  "version": "0.0.1",
  "private": true,
  "description": "Web OS de PEST AI OS : Console Admin, Espace Coopérative, Espace Agronome, Espace ONG.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs-site/static/openapi.yaml -o src/lib/api/schema.d.ts",
    "check:api": "openapi-typescript ../docs-site/static/openapi.yaml -o /tmp/pestai-schema.d.ts && diff -q /tmp/pestai-schema.d.ts src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
