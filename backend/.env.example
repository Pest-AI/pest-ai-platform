# ─────────────────────────────────────────────────────────────
# Modèle de configuration locale du backend PEST AI OS.
# Copier ce fichier en .env (cp .env.example .env) puis remplacer les valeurs.
# Le fichier .env n'est JAMAIS commité (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────

# Clé secrète Django. En générer une avec :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=a-remplacer

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base locale PostgreSQL 16 + PostGIS.
# Postgres.app : utilisateur = votre nom d'utilisateur macOS, sans mot de passe.
DATABASE_URL=postgis://VOTRE_UTILISATEUR@localhost:5432/pestai_dev

# Bibliothèques géographiques (macOS uniquement ; laisser vide sur Linux/Docker).
# Option A — Postgres.app :
GDAL_LIBRARY_PATH=/Applications/Postgres.app/Contents/Versions/16/lib/libgdal.dylib
GEOS_LIBRARY_PATH=/Applications/Postgres.app/Contents/Versions/16/lib/libgeos_c.dylib
# Option B — Homebrew (brew install gdal geos) :
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# Origines autorisées à appeler l'API (frontend local).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Durée de vie des jetons JWT (facultatif : valeurs par défaut ci-dessous).
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

LOG_LEVEL=INFO
